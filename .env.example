# Optional. Groq reviews only compact candidates; raw chat is processed locally.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
LLM_MIN_INTERVAL_MS=30000
LLM_MAX_REQUESTS_PER_MINUTE=2
LLM_TOKEN_BUDGET_PER_MINUTE=6000
LLM_MAX_OUTPUT_TOKENS=600
# OpenAI remains available when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
LOCAL_EMBEDDING_MODEL=onnx-community/all-MiniLM-L6-v2-ONNX
# Use "hash" for an offline/no-download smoke test.
EMBEDDER=
PORT=4318

# Use "replay" for fixtures or "twitch" for read-only live chat.
CHAT_INPUT_MODE=replay
TWITCH_CLIENT_ID=
TWITCH_USER_ACCESS_TOKEN=
# Supply either the target channel login or its numeric broadcaster ID.
TWITCH_BROADCASTER_LOGIN=
TWITCH_BROADCASTER_ID=
# Optional; normally derived by validating TWITCH_USER_ACCESS_TOKEN.
TWITCH_USER_ID=

# Twitch Extension overlay identity. The secret is base64-encoded in the Extensions console.
TWITCH_EXTENSION_SECRET=
# Optional comma-separated exact origins. When blank, Twitch ext-twitch.tv origins and localhost are allowed.
TWITCH_EXTENSION_ORIGINS=
# Keep false when TWITCH_EXTENSION_SECRET is configured. Enable only for local judging previews.
ALLOW_PREVIEW_IDENTITY=false
# Set true only for a protected judging build that should expose the Signal Lab.
ENABLE_SIGNAL_LAB=false
